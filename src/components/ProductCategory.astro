---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<mds-table-row>
  <mds-table-cell class="align-baseline">
    <mds-text typography="h6" tag="div" class="whitespace-nowrap py-150">{title}</mds-text>
  </mds-table-cell>
  <mds-table-cell>
    <div class="inline-flex max-tablet:flex-col max-tablet:items-start gap-400 min-w-max">
      <slot />
    </div>
  </mds-table-cell>
</mds-table-row>
