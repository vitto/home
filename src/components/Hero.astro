---
// import DisplacedSphere from './DisplacedSphere.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import HeaderMenu from './HeaderMenu.astro';
import personalData from '../data/personal.json';
// Get base URL from Astro config
// Get base URL from Astro config and normalize it
// Remove trailing slash if present (except for root)
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl === '/' ? '' : rawBaseUrl.replace(/\/$/, '');

interface Props {
  // Inverse text for a background that fills the hero, like the Blob
  inverse?: boolean;
}

const { inverse = true } = Astro.props;
---

<section class="flex items-start justify-center px-400 relative overflow-hidden z-20">
  <div
    class:list={[
      'max-w-screen-desktop w-full mx-auto p-600 py-1200 relative z-10 text-center grid gap-400',
      inverse ? 'text-on-inverse' : 'text-fg-default',
    ]}
  >
    <div class="absolute top-600 right-0">
      {
        inverse ? (
          <HeaderMenu
            size="sm"
            iconColor="text-on-inverse group-hover:text-fg-default group-focus-visible:text-fg-default"
          />
        ) : (
          <HeaderMenu size="sm" />
        )
      }
    </div>
    <div class:list={['grid', { 'text-shadow': inverse }]}>
      <Icon name="vv/logo" class="text-[144px] justify-self-center vv-logo transition-cosmetic" />
      <h1 class="text-title-h1 vittori-o">
        Vittori<span class="inline-block animate-pulse-more">o</span>
      </h1>
      <p class="text-info-paragraph m-auto"><b>{personalData.role}</b></p>
    </div>
    <p class="text-info-detail m-auto">
      <b>
        Crafting scalable human-centered experiences<br />
        through systematic design thinking.</b
      >
    </p>
    <Button
      href="https://maggioli.com"
      class="justify-self-center"
      variant={inverse ? 'hero' : 'ghost'}
    >
      <Icon name="mi/baseline/alternate-email" />
      Maggioli Spa
    </Button>
  </div>
</section>
