---
/*
  First-paint colors. The color tokens themselves (colors-rgb.css, semantic.css)
  come from the Magma styles imported by global.css, so they follow every release
  instead of a hand-copied snapshot; the mode class and data-magma-pref are already
  on <html> from the server (see utils/preferences.ts).
*/
---

<style is:global>
  /* As in the Magma base.css for Tailwind 4: the Tailwind 3 base entry has no mode rules. */
  :root:not([data-magma-pref]),
  :root.pref-mode-system {
    color-scheme: light dark;
  }

  :root.pref-mode-light {
    color-scheme: light;
  }

  :root.pref-mode-dark {
    color-scheme: dark;
  }

  html,
  body {
    background-color: rgb(var(--magma-surface-default));
    color: rgb(var(--magma-text-default));
  }

  html body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-color: rgb(var(--magma-surface-default));
    z-index: 1000;
    pointer-events: none;
  }
</style>
