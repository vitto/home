---
import Usage from '../../../Usage.astro';
import UsageItem from '../../../UsageItem.astro';
import UseCase from '../../../UseCase.astro';
import UseCaseInteractive from '../../../UseCaseInteractive.astro';
import userData from '../../../../data/use-cases/users.json';
import videosData from '../../../../data/use-cases/videos.json';

// Get base URL from Astro config and normalize it
// Remove trailing slash if present (except for root)
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl === '/' ? '' : rawBaseUrl.replace(/\/$/, '');
const user = userData[0]; // Use first user from the data
---

<UseCase
  title="Reuse of Previous Input"
  description="The system reduces effort by remembering and reusing previous user inputs, selections, or patterns."
>
  <UseCaseInteractive clsHeight={414}>
    <div class="grid gap-600 w-full @container">
      <div class="flex items-baseline justify-between">
        <mds-text typography="h5">Recently viewed</mds-text>
        <mds-button
          class="hover:bg-wash-soft focus-visible:bg-wash-soft"
          size="sm"
          icon="mi/outline/arrow-forward"
          icon-position="right"
          variant="dark"
          tone="text"
          label="View all"></mds-button>
      </div>
      <div
        class="grid gap-y-400 gap-x-100 grid-cols-1 @min-[25rem]:grid-cols-2 @min-[35rem]:grid-cols-3"
      >
        {
          videosData.map((video) => (
            <div
              class="grid gap-200 p-200 hover:bg-wash-base cursor-pointer focus-bounce rounded-md auto-rows-min"
              tabindex="0"
            >
              <mds-img class="rounded-xs" src={`${baseUrl}${video.image}`} alt={video.title} />
              <div class="grid gap-200 grid-cols-[1fr_auto]">
                <mds-text typography="h6" truncate="all">
                  {video.title}
                </mds-text>
                <mds-badge
                  size="sm"
                  variant="dark"
                  tone="outline"
                  class="self-start justify-self-end"
                >
                  {video.duration}
                </mds-badge>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </UseCaseInteractive>
  <Usage>
    <UsageItem variant="do">Reuse previous inputs where appropriate</UsageItem>
    <UsageItem variant="dont">Force users to re-enter the same data repeatedly</UsageItem>
    <UsageItem variant="do">Make reused data visible and editable</UsageItem>
    <UsageItem variant="dont">Auto-apply past data without user awareness</UsageItem>
    <UsageItem variant="do">Respect privacy and data sensitivity</UsageItem>
    <UsageItem variant="dont">Store or reuse sensitive data implicitly</UsageItem>
  </Usage>
</UseCase>
