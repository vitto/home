---
import HighlightBox from './HighlightBox.astro';

interface Cv {
  highlight?: boolean;
  id: number;
  name: string;
  role: string;
  seniority: string;
  location: string;
  image?: string;
  jobMatchScore: number;
  aiConfidence: number;
  confidenceReasons: string[];
  riskFlags: string[];
}

interface Props {
  cv: Cv;
  highlight?: boolean;
}

const { cv, highlight = false } = Astro.props as Props;

function getConfidenceBadgeVariant(confidence: number): 'success' | 'info' | 'warning' | 'error' {
  if (confidence >= 0.9) return 'success';
  if (confidence >= 0.75) return 'warning';
  if (confidence >= 0.6) return 'error';
  return 'error';
}

function getConfidenceBox(confidence: number): string {
  if (confidence >= 0.9) return 'bg-success-wash-soft border-success-border-muted';
  if (confidence >= 0.75) return 'bg-warning-wash-soft border-warning-border-muted';
  if (confidence >= 0.6) return 'bg-danger-wash-soft border-danger-border-muted';
  return 'bg-danger-wash-soft';
}
---

<div class="flex flex-col rounded-lg bg-surface-raised auto-rows-min shadow-xs-sharp h-min">
  <div class="grid gap-200 p-400">
    <div class="flex items-center justify-between gap-400">
      <mds-avatar src={cv.image} size="sm"></mds-avatar>
      {
        cv.aiConfidence < 0.9 && highlight && (
          <div class="grow">
            <HighlightBox label="Encourage verification">
              <div class="flex justify-end">
                <mds-button
                  title="Double-check this CV before rejecting or shortlisting."
                  variant="dark"
                  tone="strong"
                  label="Review"
                />
              </div>
            </HighlightBox>
          </div>
        )
      }
      {
        cv.aiConfidence < 0.9 && !highlight && (
          <mds-button
            title="Double-check this CV before rejecting or shortlisting."
            variant="dark"
            tone="strong"
            label="Review"
          />
        )
      }
    </div>
    <div class="grid gap-50">
      <mds-text typography="h6">{cv.name}</mds-text>
      <mds-text typography="caption" class="text-fg-muted">
        {cv.role} · {cv.seniority} · {cv.location}
      </mds-text>
      <mds-text typography="caption" class="text-fg-muted">
        Match score <b>{cv.jobMatchScore} / 100</b>
      </mds-text>
    </div>
  </div>
  <div
    class={`grid gap-400 p-400 rounded-b-lg border-solid border-0 border-t ${getConfidenceBox(cv.aiConfidence)}`}
  >
    <mds-badge
      variant={getConfidenceBadgeVariant(cv.aiConfidence)}
      tone="weak"
      size="sm"
      class="justify-self-start"
    >
      AI {Math.round(cv.aiConfidence * 100)}% confidence
    </mds-badge>
    <div class="grid gap-400">
      <!-- <mds-text typography="label" class="text-fg-muted">why this candidate</mds-text> -->
      <mds-list class="pl-0 fill-success-emphasis">
        {
          cv.confidenceReasons.map((reason) => (
            <mds-list-item icon="mi/baseline/check" typography="caption">
              {reason}
            </mds-list-item>
          ))
        }
      </mds-list>
      <!-- </div>
    <div class="grid gap-400"> -->
      <!-- <mds-text typography="label" class="text-fg-muted">risks to consider</mds-text> -->
      <mds-list class="pl-0">
        {
          cv.riskFlags.map((flag) => (
            <mds-list-item icon="mi/outline/warning-amber" typography="caption">
              {flag}
            </mds-list-item>
          ))
        }
      </mds-list>
    </div>
  </div>
</div>
