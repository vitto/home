---
/**
 * Blobmixer Component
 *
 * A blob of gradients under colored spotlights, as the Blobmixer by 14islands mixes it
 * (https://blobmixer.14islands.com): its material, its noise, its lights and the 14 blobs of its
 * gallery, rebuilt with plain Three.js from the sources the site publishes.
 * The Blobmixer is licensed CC BY-NC-SA 4.0 (https://creativecommons.org/licenses/by-nc-sa/4.0/),
 * and so are this component, the presets in blobmixer-presets.json and the gradients in
 * public/assets/blobmixer. The environment map is Peppermint Powerplant by Andreas Mischok,
 * CC0 from Poly Haven (https://polyhaven.com/a/peppermint_powerplant).
 * It answers the same window.updateBlobConfig / resetBlobConfig calls as the Blob,
 * so the category cards drive it, naming a preset in their config.
 *
 * Props:
 * @param {string} preset - Blob shown at rest, a key of blobmixer-presets.json (default: 't-1000')
 * @param {number} tint - Share of the tint color painted over the page behind the blob, 0 leaves the page as it is;
 *                        a card config can set its own (default: 0)
 * @param {string} tintColor - Which color of a card config tints the page: 'accent', the one recommended with its
 *                             blob, or 'dominant', the label closest to the dominant color of the blob; without one,
 *                             the background color of the preset (default: 'accent')
 * @param {number} cameraFov - Camera field of view (default: 15)
 * @param {number} cameraDistance - Camera distance (default: 4)
 * @param {number} positionY - Y position offset for desktop (viewport width > 480px, default: -0.2)
 * @param {number} positionYMobile - Y position offset for mobile (viewport width <= 480px, default: same as positionY)
 * @param {number} scale - Radius of the blob (default: 1)
 * @param {number} maxScrollTranslate - Maximum translateY value in pixels when page is fully scrolled (default: 0, disabled)
 * @param {string} anchor - Selector of the element the blob rests on: its lower edge sits on the top of the element
 *                          and scrolls with it, in place of positionY and maxScrollTranslate (default: '')
 * @param {number} anchorOverlap - How far the lower edge of the blob goes under the anchor's top, in CSS pixels (default: 0)
 */
import presets from '../data/blobmixer-presets.json';

interface Props {
  preset?: keyof typeof presets;
  tint?: number;
  tintColor?: 'accent' | 'dominant';
  cameraFov?: number;
  cameraDistance?: number;
  positionY?: number;
  positionYMobile?: number;
  scale?: number;
  maxScrollTranslate?: number;
  anchor?: string;
  anchorOverlap?: number;
}

const {
  preset = 't-1000',
  tint = 0,
  tintColor = 'accent',
  cameraFov = 15,
  cameraDistance = 4,
  positionY = -0.2,
  positionYMobile,
  scale = 1,
  maxScrollTranslate = 0,
  anchor = '',
  anchorOverlap = 0,
} = Astro.props;

// Get base URL from Astro config and normalize it
// Remove trailing slash if present (except for root)
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl === '/' ? '' : rawBaseUrl.replace(/\/$/, '');
---

<div id="blobmixer-tint"></div>
<div id="blobmixer-container">
  <canvas id="blobmixer-canvas" aria-hidden="true"></canvas>
</div>

<script
  type="module"
  defer
  define:vars={{
    presets,
    preset,
    tint,
    tintColor,
    cameraFov,
    cameraDistance,
    positionY,
    positionYMobile: positionYMobile !== undefined ? positionYMobile : positionY,
    scale,
    maxScrollTranslate,
    anchor,
    anchorOverlap,
    baseUrl,
  }}
>
  // The Blobmixer blob has a radius of 0.14, and its lights sit at a tenth of their values:
  // these turn light positions and distances into radii of the blob
  const LIGHT_UNIT = 0.1 / 0.14;

  // The noise loops every 12 seconds, its period repeating 3 times
  const NOISE_PERIOD_REPEAT = 3;
  const NOISE_PERIOD = 12 / NOISE_PERIOD_REPEAT;

  // Rings of the sphere, a third more around it so the faces come out even
  const SEGMENTS = window.innerWidth <= 768 ? 256 : 512;

  const TWEEN_DURATION = 2000;

  // The most lights a preset has: the others get dark ones to tween from
  const LIGHT_COUNT = Math.max(...Object.values(presets).map((blob) => blob.lights.length));

  // GLSL textureless classic 3D noise "cnoise",
  // with an RSL-style periodic variant "pnoise".
  // Author:  Stefan Gustavson (stefan.gustavson@liu.se)
  // Copyright (c) 2011 Stefan Gustavson. Distributed under the MIT license.
  // https://github.com/ashima/webgl-noise
  //
  // Then the Blobmixer displacement: a slow goo noise and waves along the height,
  // each fading towards the poles by its pole amount.
  const displacementHeader = `
    vec3 mod289(vec3 x) {
      return x - floor(x * (1.0 / 289.0)) * 289.0;
    }

    vec4 mod289(vec4 x) {
      return x - floor(x * (1.0 / 289.0)) * 289.0;
    }

    vec4 permute(vec4 x) {
      return mod289(((x*34.0)+1.0)*x);
    }

    vec4 taylorInvSqrt(vec4 r) {
      return 1.79284291400159 - 0.85373472095314 * r;
    }

    vec3 fade(vec3 t) {
      return t*t*t*(t*(t*6.0-15.0)+10.0);
    }

    // Classic Perlin noise, periodic variant
    float pnoise(vec3 P, vec3 rep) {
      vec3 Pi0 = mod(floor(P), rep);
      vec3 Pi1 = mod(Pi0 + vec3(1.0), rep);
      Pi0 = mod289(Pi0);
      Pi1 = mod289(Pi1);
      vec3 Pf0 = fract(P);
      vec3 Pf1 = Pf0 - vec3(1.0);
      vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
      vec4 iy = vec4(Pi0.yy, Pi1.yy);
      vec4 iz0 = Pi0.zzzz;
      vec4 iz1 = Pi1.zzzz;

      vec4 ixy = permute(permute(ix) + iy);
      vec4 ixy0 = permute(ixy + iz0);
      vec4 ixy1 = permute(ixy + iz1);

      vec4 gx0 = ixy0 * (1.0 / 7.0);
      vec4 gy0 = fract(floor(gx0) * (1.0 / 7.0)) - 0.5;
      gx0 = fract(gx0);
      vec4 gz0 = vec4(0.5) - abs(gx0) - abs(gy0);
      vec4 sz0 = step(gz0, vec4(0.0));
      gx0 -= sz0 * (step(0.0, gx0) - 0.5);
      gy0 -= sz0 * (step(0.0, gy0) - 0.5);

      vec4 gx1 = ixy1 * (1.0 / 7.0);
      vec4 gy1 = fract(floor(gx1) * (1.0 / 7.0)) - 0.5;
      gx1 = fract(gx1);
      vec4 gz1 = vec4(0.5) - abs(gx1) - abs(gy1);
      vec4 sz1 = step(gz1, vec4(0.0));
      gx1 -= sz1 * (step(0.0, gx1) - 0.5);
      gy1 -= sz1 * (step(0.0, gy1) - 0.5);

      vec3 g000 = vec3(gx0.x,gy0.x,gz0.x);
      vec3 g100 = vec3(gx0.y,gy0.y,gz0.y);
      vec3 g010 = vec3(gx0.z,gy0.z,gz0.z);
      vec3 g110 = vec3(gx0.w,gy0.w,gz0.w);
      vec3 g001 = vec3(gx1.x,gy1.x,gz1.x);
      vec3 g101 = vec3(gx1.y,gy1.y,gz1.y);
      vec3 g011 = vec3(gx1.z,gy1.z,gz1.z);
      vec3 g111 = vec3(gx1.w,gy1.w,gz1.w);

      vec4 norm0 = taylorInvSqrt(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
      g000 *= norm0.x;
      g010 *= norm0.y;
      g100 *= norm0.z;
      g110 *= norm0.w;
      vec4 norm1 = taylorInvSqrt(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
      g001 *= norm1.x;
      g011 *= norm1.y;
      g101 *= norm1.z;
      g111 *= norm1.w;

      float n000 = dot(g000, Pf0);
      float n100 = dot(g100, vec3(Pf1.x, Pf0.yz));
      float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
      float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
      float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
      float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
      float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
      float n111 = dot(g111, Pf1);

      vec3 fade_xyz = fade(Pf0);
      vec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);
      vec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);
      float n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);
      return 2.2 * n_xyz;
    }

    uniform float time;
    uniform float distort;
    uniform float frequency;
    uniform float surfaceDistort;
    uniform float surfaceFrequency;
    uniform float surfaceTime;
    uniform float numberOfWaves;
    uniform float fixNormals;
    uniform float surfacePoleAmount;
    uniform float gooPoleAmount;
    uniform float noisePeriod;

    #define M_PI 3.1415926538

    float f(vec3 point) {
      float yPos = smoothstep(-1., 1., point.y);
      float amount = sin(yPos * M_PI);
      float wavePoleAmount = mix(amount * 1.0, 1.0, surfacePoleAmount);
      float gooPoleAmount = mix(amount * 1.0, 1.0, gooPoleAmount);

      // blob noise
      float goo = pnoise(vec3(point / (frequency) + mod(time, noisePeriod)), vec3(noisePeriod)) * pow(distort, 2.0);

      // wave noise
      float surfaceNoise = pnoise(vec3(point / (surfaceFrequency) + mod(surfaceTime, noisePeriod)), vec3(noisePeriod));
      float waves = (point.x * sin((point.y+surfaceNoise)*M_PI*numberOfWaves) + point.z * cos((point.y+surfaceNoise)*M_PI*numberOfWaves)) * 0.01 * pow(surfaceDistort, 2.0);

      // combined noise
      return waves * wavePoleAmount + goo * gooPoleAmount;
    }

    vec3 orthogonal(vec3 v) {
      return normalize(abs(v.x) > abs(v.z) ? vec3(-v.y, v.x, 0.0) : vec3(0.0, -v.z, v.y));
    }
  `;

  // The normals of the displaced surface come from two neighbours displaced the same way
  // (https://discourse.threejs.org/t/16989), blended in by fixNormals so a preset without them tweens
  const displacementMain = `
    vec3 displacedPosition = position + normalize(normal) * f(position);
    vec3 displacedNormal = normalize(normal);

    if (fixNormals > 0.0) {
      float offset = .5 / 512.;
      vec3 tangent = orthogonal(normal);
      vec3 bitangent = normalize(cross(normal, tangent));
      vec3 neighbour1 = position + tangent * offset;
      vec3 neighbour2 = position + bitangent * offset;
      vec3 displacedNeighbour1 = neighbour1 + normal * f(neighbour1);
      vec3 displacedNeighbour2 = neighbour2 + normal * f(neighbour2);

      vec3 displacedTangent = displacedNeighbour1 - displacedPosition;
      vec3 displacedBitangent = displacedNeighbour2 - displacedPosition;

      displacedNormal = normalize(mix(displacedNormal, normalize(cross(displacedTangent, displacedBitangent)), fixNormals));
    }
  `;

  // The Blobmixer ran on three r143, whose lights faded linearly out to their distance;
  // three now falls off with the inverse square of it, so the old falloff comes back here
  const legacyDistanceAttenuation = `
    float getDistanceAttenuation( const in float lightDistance, const in float cutoffDistance, const in float decayExponent ) {
      if ( cutoffDistance > 0.0 && decayExponent > 0.0 ) {
        return pow( saturate( - lightDistance / cutoffDistance + 1.0 ), decayExponent );
      }
      return 1.0;
    }
  `;

  // The gradient blends from the last one while the blob changes preset
  const gradientFragment = `
    #ifdef USE_MAP
      vec4 sampledDiffuseColor = mix( texture2D( gradientFrom, vMapUv ), texture2D( map, vMapUv ), gradientMix );
      diffuseColor *= sampledDiffuseColor;
    #endif
  `;

  // Store reference to updateBlobmixerConfig function (will be set when Three.js initializes)
  let updateBlobmixerConfigRef = null;
  let pendingConfigs = [];

  // Expose the Blob calls immediately, queuing them until the blob is ready
  window.updateBlobConfig = (config, animate) => {
    if (updateBlobmixerConfigRef) {
      updateBlobmixerConfigRef(config, animate);
    } else {
      pendingConfigs.push({ config, animate });
    }
  };
  window.resetBlobConfig = (animate) => window.updateBlobConfig(null, animate);

  const initBlobmixer = async () => {
    // Wait for idle time or use setTimeout as fallback
    if ('requestIdleCallback' in window) {
      await new Promise((resolve) => {
        requestIdleCallback(resolve, { timeout: 2000 });
      });
    } else {
      await new Promise((resolve) => setTimeout(resolve, 100));
    }

    // Import Three.js and its HDR loader from vendor directory (lazy load)
    const [THREE, { HDRLoader }] = await Promise.all([
      import(`${baseUrl}/vendor/three.module.min.js`),
      import(`${baseUrl}/vendor/HDRLoader.js`),
    ]);

    const canvas = document.getElementById('blobmixer-canvas');
    const container = document.getElementById('blobmixer-container');
    const tintLayer = document.getElementById('blobmixer-tint');
    if (!canvas || !container || !tintLayer) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      antialias: true,
      alpha: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    // Tone mapped as @react-three/fiber did it for the Blobmixer
    renderer.toneMapping = THREE.ACESFilmicToneMapping;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(cameraFov, 1, 0.1, 1000);
    camera.position.set(0, 0, cameraDistance);

    const textureLoader = new THREE.TextureLoader();
    const gradients = new Map();
    const loadGradient = (name) => {
      if (!gradients.has(name)) {
        const texture = textureLoader
          .loadAsync(`${baseUrl}/assets/blobmixer/gradients/${name}.png`)
          .then((loaded) => {
            loaded.colorSpace = THREE.SRGBColorSpace;
            return loaded;
          });
        gradients.set(name, texture);
      }
      return gradients.get(name);
    };

    const initialConfig = { preset, tint };

    // A preset as the numbers to tween, colors in linear RGB and lights padded to the same count,
    // with the tint the page takes behind it
    const resolveConfig = (config) => {
      const blob = presets[config.preset] ?? presets[preset];
      const { title, gradient, background, color, fixNormals, lights, ...numbers } = blob;
      const darkLight = { ...lights[0], intensity: 0 };
      return {
        gradient,
        tint: { color: config[tintColor] ?? background, share: config.tint ?? tint },
        values: {
          ...numbers,
          color: new THREE.Color(color).toArray(),
          fixNormals: fixNormals ? 1 : 0,
          lights: Array.from({ length: LIGHT_COUNT }, (_, i) => lights[i] ?? darkLight).map(
            (light) => ({ ...light, color: new THREE.Color(light.color).toArray() })
          ),
        },
      };
    };

    // Tween numbers, and arrays and objects of them, key by key
    const mix = (from, to, progress) => {
      if (typeof from === 'number') return from + (to - from) * progress;
      if (Array.isArray(from)) return from.map((value, i) => mix(value, to[i], progress));
      return Object.fromEntries(
        Object.keys(from).map((key) => [key, mix(from[key], to[key], progress)])
      );
    };

    const initial = resolveConfig(initialConfig);
    let values = initial.values;

    const [environment, initialGradient] = await Promise.all([
      new HDRLoader().loadAsync(`${baseUrl}/assets/blobmixer/peppermint_powerplant_1k.hdr`),
      loadGradient(initial.gradient),
    ]);
    environment.mapping = THREE.EquirectangularReflectionMapping;
    scene.environment = environment;

    const uniforms = {
      time: { value: 0 },
      distort: { value: 0 },
      frequency: { value: 1 },
      surfaceDistort: { value: 0 },
      surfaceFrequency: { value: 1 },
      surfaceTime: { value: 0 },
      numberOfWaves: { value: 0 },
      fixNormals: { value: 1 },
      surfacePoleAmount: { value: 1 },
      gooPoleAmount: { value: 1 },
      noisePeriod: { value: NOISE_PERIOD },
      gradientFrom: { value: initialGradient },
      gradientMix: { value: 1 },
    };

    const material = new THREE.MeshPhysicalMaterial({
      map: initialGradient,
      transparent: true,
    });
    material.onBeforeCompile = (shader) => {
      Object.assign(shader.uniforms, uniforms);

      shader.vertexShader = `${displacementHeader}\n${shader.vertexShader}`
        .replace('void main() {', `void main() {\n${displacementMain}`)
        .replace('#include <displacementmap_vertex>', 'transformed = displacedPosition;')
        .replace(
          '#include <defaultnormal_vertex>',
          THREE.ShaderChunk.defaultnormal_vertex.replace(
            'vec3 transformedNormal = objectNormal;',
            'vec3 transformedNormal = displacedNormal;'
          )
        );

      shader.fragmentShader =
        `uniform sampler2D gradientFrom;\nuniform float gradientMix;\n${shader.fragmentShader}`
          .replace('#include <map_fragment>', gradientFragment)
          .replace(
            '#include <lights_pars_begin>',
            THREE.ShaderChunk.lights_pars_begin.replace(
              /float getDistanceAttenuation\([\s\S]*?\n}\n/,
              legacyDistanceAttenuation
            )
          );
    };

    const mesh = new THREE.Mesh(
      new THREE.SphereGeometry(1, Math.round(SEGMENTS * 1.33), SEGMENTS),
      material
    );
    // The shader moves the vertices past the sphere bounds
    mesh.frustumCulled = false;

    const ambientLight = new THREE.AmbientLight('white', 0);
    const spotLights = Array.from({ length: LIGHT_COUNT }, () => {
      const spotLight = new THREE.SpotLight();
      spotLight.target = mesh;
      return spotLight;
    });

    // The blob and its lights scale together, so the lights fall on it as in the Blobmixer
    const group = new THREE.Group();
    group.add(mesh, ...spotLights);
    scene.add(group, ambientLight);

    // Determine current positionY based on viewport width (mobile breakpoint: 480px)
    const getCurrentPositionY = () => (window.innerWidth <= 480 ? positionYMobile : positionY);
    group.position.set(0, getCurrentPositionY(), 0);
    group.scale.setScalar(scale);

    // With an anchor, the blob rests its lower edge on the anchor's top and scrolls with it
    const anchorElement = anchor ? document.querySelector(anchor) : null;

    // Page top of the anchor without its transforms, so intro and hover lifts don't move the blob
    const getAnchorTop = () => {
      let top = 0;
      for (let element = anchorElement; element; element = element.offsetParent) {
        top += element.offsetTop;
      }
      return top;
    };

    // Height of the blob's center that puts its lower edge at a y of the canvas, in CSS pixels:
    // the edge is where a ray from the camera grazes the sphere
    const centerForEdge = (edgeY) => {
      const halfFov = THREE.MathUtils.degToRad(cameraFov / 2);
      const tangent = (1 - (2 * edgeY) / container.clientHeight) * Math.tan(halfFov);
      const radius = scale * values.scale;
      return radius / Math.cos(Math.atan(tangent)) + cameraDistance * tangent;
    };

    // The page takes a share of the tint color, through CSS so theme tokens follow the mode;
    // at no share it fades out keeping the last color
    let lastTintColor = null;
    const paintTint = ({ color, share }) => {
      if (share > 0) lastTintColor = color;
      tintLayer.style.backgroundColor = lastTintColor
        ? `color-mix(in srgb, ${lastTintColor} ${share * 100}%, transparent)`
        : '';
    };
    paintTint(initial.tint);

    // Lights shine Math.PI times stronger than in three r143, which spread them over a hemisphere
    const apply = () => {
      material.color.fromArray(values.color);
      material.roughness = values.roughness;
      material.metalness = values.metalness;
      material.envMapIntensity = values.envMapIntensity;
      material.clearcoat = values.clearcoat;
      material.clearcoatRoughness = values.clearcoatRoughness;
      material.transmission = values.transmission;

      uniforms.distort.value = values.distort;
      uniforms.frequency.value = values.frequency;
      uniforms.gooPoleAmount.value = values.gooPoleAmount;
      uniforms.surfaceDistort.value = values.surfaceDistort;
      uniforms.surfaceFrequency.value = values.surfaceFrequency;
      uniforms.numberOfWaves.value = values.numberOfWaves;
      uniforms.surfacePoleAmount.value = values.surfacePoleAmount;
      uniforms.fixNormals.value = values.fixNormals;

      mesh.scale.setScalar(values.scale);
      mesh.rotation.set(...values.rotation);

      ambientLight.intensity = values.ambient * Math.PI;
      values.lights.forEach((light, i) => {
        const spotLight = spotLights[i];
        spotLight.color.fromArray(light.color);
        spotLight.intensity = light.intensity * Math.PI;
        spotLight.angle = light.angle;
        // The falloff reads the distance in the scene, outside the group scale
        spotLight.distance = light.distance * LIGHT_UNIT * scale;
        spotLight.penumbra = light.penumbra;
        spotLight.decay = light.decay;
        spotLight.position.fromArray(light.position).multiplyScalar(LIGHT_UNIT);
      });
    };

    // Easing function for smooth transitions (easeOutExpo)
    const easeOutExpo = (t) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

    let tween = null;
    let latestRequest = 0;

    // Scrolled above the viewport, an anchored blob is out of sight: its empty frame is drawn once,
    // then it rests until it comes back
    let inSight = true;

    const draw = (now) => {
      if (tween) {
        const progress = Math.min((now - tween.start) / TWEEN_DURATION, 1);
        const eased = easeOutExpo(progress);
        values = mix(tween.from, tween.to, eased);
        uniforms.gradientMix.value = mix(tween.fromGradientMix, 1, eased);
        if (progress === 1) tween = null;
      }
      if (anchorElement) {
        const edgeY = getAnchorTop() - window.scrollY + anchorOverlap;
        group.position.y = centerForEdge(edgeY);
        const wasInSight = inSight;
        inSight = edgeY > 0;
        if (!inSight && !wasInSight) return;
      }
      apply();
      renderer.render(scene, camera);
    };

    async function updateBlobmixerConfig(config, animate = true) {
      const request = ++latestRequest;
      const to = resolveConfig(config ? { ...initialConfig, ...config } : initialConfig);
      const gradient = await loadGradient(to.gradient).catch(() => material.map);
      // A later call took over while the gradient loaded
      if (request !== latestRequest) return;

      paintTint(to.tint);

      // Blend from the gradient that shows the most, unless it's the one coming
      let fromGradientMix = uniforms.gradientMix.value;
      if (gradient !== material.map) {
        uniforms.gradientFrom.value =
          uniforms.gradientMix.value >= 0.5 ? material.map : uniforms.gradientFrom.value;
        material.map = gradient;
        fromGradientMix = 0;
      }

      if (!animate || reducedMotion) {
        values = to.values;
        uniforms.gradientMix.value = 1;
        tween = null;
        if (reducedMotion) draw(performance.now());
        return;
      }

      tween = { from: values, to: to.values, fromGradientMix, start: performance.now() };
    }

    const onResize = () => {
      const width = container.clientWidth;
      const height = container.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      if (!anchorElement) group.position.y = getCurrentPositionY();
      if (reducedMotion) draw(performance.now());
    };

    onResize();
    window.addEventListener('resize', onResize);

    // Move the blob up while the page scrolls down
    if (maxScrollTranslate > 0) {
      let scrollFrame = null;
      const updateScrollParallax = () => {
        scrollFrame = null;
        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        const scrollProgress = maxScroll > 0 ? Math.min(window.scrollY / maxScroll, 1) : 0;
        container.style.setProperty(
          '--scroll-translate-y',
          `${-scrollProgress * maxScrollTranslate}px`
        );
      };
      updateScrollParallax();
      window.addEventListener(
        'scroll',
        () => {
          scrollFrame ??= requestAnimationFrame(updateScrollParallax);
        },
        { passive: true }
      );
      window.addEventListener('resize', updateScrollParallax);
    }

    // Replace the queue with the actual function and apply what arrived before
    updateBlobmixerConfigRef = updateBlobmixerConfig;
    pendingConfigs.forEach(({ config, animate }) => updateBlobmixerConfig(config, animate));
    pendingConfigs = [];

    if (reducedMotion) {
      draw(performance.now());
      // Still follow the anchor while the page scrolls
      if (anchorElement) {
        let scrollFrame = null;
        window.addEventListener(
          'scroll',
          () => {
            scrollFrame ??= requestAnimationFrame((now) => {
              scrollFrame = null;
              draw(now);
            });
          },
          { passive: true }
        );
      }
    } else {
      let lastFrameTime = performance.now();
      const animate = (now) => {
        requestAnimationFrame(animate);
        const deltaTime = Math.min((now - lastFrameTime) / 1000, 0.1);
        lastFrameTime = now;
        uniforms.time.value += (deltaTime * values.speed) / NOISE_PERIOD_REPEAT;
        uniforms.surfaceTime.value += (deltaTime * values.surfaceSpeed) / NOISE_PERIOD_REPEAT;
        draw(now);
      };
      requestAnimationFrame(animate);
    }

    canvas.classList.add('is-ready');
  };

  // Start initialization
  initBlobmixer();
</script>

