---
interface Props {
  href?: string;
  logo?: string;
  alt?: string;
  label?: string;
}

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl === '/' ? '' : rawBaseUrl.replace(/\/$/, '');

const {
  href = 'https://magma.maggiolicloud.it',
  logo = `${baseUrl}/assets/projects/magma-design-system-logo.svg`,
  alt = 'Magma Design System Logo',
  label = 'Magma Design System',
} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer noopener"
  class="group group/footer-link focus-bounce hover:-translate-y-200 focus:-translate-y-200 ease-out-expo duration-1000 no-underline p-400 rounded-lg grid grid-cols-full auto-rows-min gap-200 items-start justify-center max-w-3600 w-full transition-transform"
>
  <div
    class="group-hover:bg-surface-raised group-hover:shadow-xs-sharp group-[&:is(:hover,:focus-visible)]/footer-link:bg-surface-raised group-[&:is(:hover,:focus-visible)]/footer-link:shadow-xs-sharp ease-out-expo duration-1000 p-400 bg-transparent rounded-xs transition-colors"
  >
    <img src={logo} alt={alt} class="w-full object-contain" />
  </div>
  <mds-text typography="detail" class="text-fg-muted"><b>{label}</b></mds-text>
</a>
