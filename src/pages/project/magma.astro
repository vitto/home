---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/pages/magma/Hero.astro';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import data from '../../data/projects.json';
import magmaData from '../../data/projects/magma.json';
import ProjectBlock from '../../components/ProjectBlock.astro';
import Resource from '../../components/pages/magma/Resource.astro';
import BeforeAfterFlip from '../../components/pages/magma/BeforeAfterFlip.astro';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl === '/' ? '' : rawBaseUrl.replace(/\/$/, '');

function shuffle<T>(items: T[]): T[] {
  const shuffled = [...items];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

const randomizedComponentNames = shuffle(magmaData.components);
const heroImages = randomizedComponentNames.map((componentName) => ({
  src: `${baseUrl}/assets/magma-design-system/${componentName}.png`,
  alt: componentName.replace(/^mds-/, '').replace(/-/g, ' '),
}));

const componentCount = 90;

type GovernanceStack = {
  name: string;
  url: string;
  description?: string;
  descriptionClass?: string;
  supports?: string[];
  logo: string;
  className?: string;
};

const governanceStacks: GovernanceStack[] = [
  {
    name: 'StackOverflow teams',
    description: 'Questions and answers',
    descriptionClass: 'bg-label-orange-10 group-hover:shadow-label-orange-09',
    url: 'https://stackoverflowteams.com/c/magma-design-system/questions',
    className: 'hover:bg-label-orange-10',
    logo: `${baseUrl}/assets/projects/governance-stack-overflow-logo.svg`,
  },
  {
    name: 'GitLab Issues',
    description: 'Issues and feature requests',
    descriptionClass: 'bg-label-orange-10 group-hover:shadow-label-orange-09',
    url: 'https://gitlab.com/maggiolispa/ricerca-sviluppo-new-media/magma/design-system/-/work_items',
    className: 'hover:bg-label-orange-10',
    logo: `${baseUrl}/assets/projects/governance-gitlab-logo.svg`,
  },
  {
    name: 'Storybook',
    description: 'Test all the components here',
    descriptionClass: 'bg-label-amaranth-10 group-hover:shadow-label-amaranth-09',
    url: 'https://magma.maggiolicloud.it/storybook/',
    className: 'hover:bg-label-amaranth-10',
    logo: `${baseUrl}/assets/projects/governance-storybook-logo.svg`,
  },
  // {
  //   name: 'Magma Design System',
  //   description: 'The living documentation under development',
  //   descriptionClass: 'bg-variant-primary-10 group-hover:shadow-variant-primary-09',
  //   url: 'https://magma.maggiolicloud.it/',
  //   className: 'hover:bg-variant-primary-10',
  //   logo: `${baseUrl}/assets/projects/magma-design-system-logo.svg`,
  // },
];

type Supports = 'web-components' | 'tokens' | 'wrapper' | 'css-tokens';

type SupportedStack = {
  name: string;
  url: string;
  supports?: Supports[];
  logo: string;
};

const supportedStacks: SupportedStack[] = [
  {
    name: 'Angular',
    url: 'https://angular.dev/',
    logo: `${baseUrl}/assets/projects/tech-angular-logo.svg`,
    supports: ['wrapper'],
  },
  {
    name: 'React',
    url: 'https://react.dev/',
    logo: `${baseUrl}/assets/projects/tech-react-logo.svg`,
    supports: ['wrapper'],
  },
  {
    name: 'Flutter',
    url: 'https://flutter.dev/',
    logo: `${baseUrl}/assets/projects/tech-flutter-logo.svg`,
    supports: ['tokens'],
  },
  {
    name: 'WordPress',
    url: 'https://wordpress.org/',
    logo: `${baseUrl}/assets/projects/tech-wordpress-logo.svg`,
    supports: ['web-components'],
  },
  {
    name: 'HTML',
    url: 'https://html.com/',
    logo: `${baseUrl}/assets/projects/tech-html-logo-alt.svg`,
    supports: ['web-components', 'tokens', 'css-tokens'],
  },
];

const platformSupportColumns: Supports[] = ['wrapper', 'tokens', 'web-components', 'css-tokens'];

function stackSupports(stack: SupportedStack, capability: Supports): boolean {
  return stack.supports?.includes(capability) ?? false;
}
---

<ProjectLayout title={data.magma.title} pagePath="/project/magma">
  <Hero images={heroImages}>
    <div class="grid gap-400">
      <div class="flex gap-600">
        <mds-img
          src={`${baseUrl}/assets/projects/logo-gruppo-maggioli.svg`}
          alt="Magma Design System Logo"
          class="w-full max-w-1200 object-contain"></mds-img>
        <mds-img
          src={`${baseUrl}/assets/projects/magma-design-system-logo.svg`}
          alt="Magma Design System Logo"
          class="w-full max-w-1200 object-contain"></mds-img>
      </div>
      <mds-text typography="h1">Magma Design System</mds-text>
      <mds-text typography="paragraph">
        A component ecosystem, guidelines and patterns to build consistent, accessible, high-quality
        user interfaces.
      </mds-text>
    </div>
  </Hero>
  <ProjectBlock columns="grid-cols-[2fr_1fr]">
    <div>
      <BeforeAfterFlip
        beforeSrc={`${baseUrl}/assets/projects/example-before-01.svg`}
        afterSrc={`${baseUrl}/assets/projects/example-after-01.svg`}
        beforeAlt="Before example"
        afterAlt="After example"
      />
    </div>
    <div class="grid gap-200 auto-rows-min tablet:sticky top-2800 self-start">
      <mds-text typography="h2">A product ecosystem</mds-text>
      <mds-text typography="paragraph">
        Magma was built to help Maggioli Spa bring consistency across its product suite. Not a style
        library, but a structured system of decisions: every component, every pattern, every token
        carries an explicit reason and constraint.
      </mds-text>
    </div>
  </ProjectBlock>
  <ProjectBlock>
    <div class="grid gap-200 auto-rows-min tablet:sticky top-2800 self-start">
      <mds-text typography="h2">Agnostic, everywhere</mds-text>
      <mds-text typography="paragraph">
        Designed to adapt to different technologies — React, Angular, WordPress — through the
        flexibility and scalability of Web Components. Every component is consumable from any stack
        without dependencies. Angular and React wrappers are automatically generated, so every team
        can adopt Magma without rewriting their product.
      </mds-text>
    </div>
    <div>
      <mds-img
        src={`${baseUrl}/assets/projects/adoption.svg`}
        alt="Magma Design System Logo"
        class="w-full object-contain"></mds-img>
    </div>
  </ProjectBlock>
  <ProjectBlock columns="grid-cols-3">
    <mds-text typography="paragraph">
      Maggioli develops software for different markets: publishing, public administration,
      enterprise software. Separate teams, separate stacks, separate visual choices.
    </mds-text>
    <mds-text typography="paragraph">
      The result was products that felt unrelated to each other, development costs duplicated on
      already-solved problems, and inconsistent UX from project to project.
    </mds-text>
    <mds-text typography="paragraph">
      The instinctive answer would have been an external library. The right answer was something
      that could grow with the products and adapt to the brand identity of a complex group.
    </mds-text>
  </ProjectBlock>

  <ProjectBlock columns="grid-cols-[2fr_1fr]">
    <div>
      <BeforeAfterFlip
        beforeSrc={`${baseUrl}/assets/projects/example-migration-structure.svg`}
        afterSrc={`${baseUrl}/assets/projects/example-migration-frontend.svg`}
        beforeAlt="Structure"
        afterAlt="Frontend"
        beforeLabel="Structure"
        afterLabel="Frontend"
      />
    </div>
    <div class="grid gap-200 auto-rows-min tablet:sticky top-2800 self-start">
      <mds-text typography="h2">An architecture designed for gradual adoption</mds-text>
      <mds-text typography="paragraph">
        The most important constraint in a company with legacy products is not technology — it's
        migration. A monolith demands total commitment that most teams simply cannot afford.
      </mds-text>
    </div>
  </ProjectBlock>
  <ProjectBlock columns="grid-cols-2">
    <div class="grid gap-200 auto-rows-min tablet:sticky top-2800 self-start">
      <mds-text typography="h2">The right level of adoption</mds-text>
      <mds-text typography="paragraph">
        A team can start with Design Tokens alone as CSS custom properties, add one component at a
        time, without touching the rest of their product. This made adoption possible even on
        Angular products with years of existing code, on WordPress projects, and on new React
        products — all consuming the same tokens and the same components.
      </mds-text>
    </div>
    <div>
      <BeforeAfterFlip
        beforeSrc={`${baseUrl}/assets/projects/example-migration-structure-magma-low.svg`}
        afterSrc={`${baseUrl}/assets/projects/example-migration-structure-magma.svg`}
        beforeAlt="Structure"
        afterAlt="Frontend"
        beforeLabel="Structure"
        afterLabel="Frontend"
      />
    </div>
  </ProjectBlock>
  <ProjectBlock columns="grid-cols-3" class="bg-variant-primary-03 text-tone-neutral-10">
    <mds-text typography="h1" tag="h2" class="col-span-3 text-center">
      A Design System that doesn't evolve,{' '}
      <span data-scroll-shift class="inline-block origin-bottom-left will-change-transform"
        >dies.</span
      >
    </mds-text>
  </ProjectBlock>
  <ProjectBlock columns="grid-cols-3">
    <div class="grid gap-200 auto-rows-min">
      <mds-text typography="h4" tag="h2">Monorepo based</mds-text>
      <mds-text typography="paragraph">
        Magma is structured as a monorepo with Nx, with a clear pipeline for proposing, reviewing
        and releasing changes.
      </mds-text>
    </div>
    <div class="grid gap-200 auto-rows-min">
      <mds-text typography="h4" tag="h2">Accessibility obsessed</mds-text>
      <mds-text typography="paragraph">
        Issue templates include WCAG accessibility criteria as an explicit requirement — not a final
        checklist, but an entry condition.
      </mds-text>
    </div>
    <div class="grid gap-200 auto-rows-min">
      <mds-text typography="h4" tag="h2">Living documentation</mds-text>
      <mds-text typography="paragraph">
        Every component is documented with its variants, states and tokens. Not a separate document
        that goes stale — the code is the documentation.
      </mds-text>
    </div>
  </ProjectBlock>
  <ProjectBlock columns="grid-cols-2">
    <div class="grid gap-600 auto-rows-min">
      <div class="grid gap-200 auto-rows-min">
        <mds-benchmark-bar value="65" alias="up to 35%">Cost reduction estimated</mds-benchmark-bar>
      </div>
      <div class="grid gap-200 auto-rows-min">
        <mds-text typography="label">{componentCount}+ components</mds-text>
        <div class="flex flex-wrap gap-200">
          {
            Array.from({ length: componentCount }, () => (
              <div class="size-500 bg-tone-neutral-01 rounded-full" />
            ))
          }
        </div>
      </div>
    </div>
    <div class="grid gap-200 auto-rows-min">
      <mds-text typography="label">Governance</mds-text>
      <div class="grid grid-cols-2 gap-600 -mx-600">
        {
          governanceStacks.map((stack) => (
            <Resource
              description={stack.description}
              descriptionClass={stack.descriptionClass}
              url={stack.url}
              logo={stack.logo}
              name={stack.name}
              className={stack.className}
            />
          ))
        }
      </div>
    </div>
  </ProjectBlock>
  <ProjectBlock columns="grid-cols-1">
    <div class="grid gap-1200 max-w-screen-desktop w-full mx-auto">
      <mds-text typography="label">Supported stacks</mds-text>
    </div>
    <mds-table>
      <mds-table-header>
        <mds-table-header-cell label="Platform" sortable></mds-table-header-cell>
        <mds-table-header-cell label="Framework wrapper"></mds-table-header-cell>
        <mds-table-header-cell label="Tokens"></mds-table-header-cell>
        <mds-table-header-cell label="Web Components"></mds-table-header-cell>
        <mds-table-header-cell label="CSS tokens"></mds-table-header-cell>
      </mds-table-header>
      <mds-table-body>
        {
          supportedStacks.map((stack) => (
            <mds-table-row>
              <mds-table-cell class="w-full" value={stack.name}>
                <a href={stack.url} class="inline-flex focus-bounce rounded">
                  <img
                    title={`Go to ${stack.name} website`}
                    src={stack.logo}
                    alt={stack.name}
                    class="max-h-500"
                  />
                </a>
              </mds-table-cell>
              {platformSupportColumns.map((capability) => (
                <mds-table-cell>
                  {stackSupports(stack, capability) ? (
                    <div class="size-700 flex items-center justify-center bg-status-success-08 rounded-full">
                      <mds-icon name="mi/baseline/check" class="fill-status-success-06" />
                    </div>
                  ) : (
                    <div class="size-700 flex items-center justify-center bg-tone-neutral-09 rounded-full">
                      <mds-icon name="mi/baseline/minus" class="fill-tone-neutral-06" />
                    </div>
                  )}
                </mds-table-cell>
              ))}
            </mds-table-row>
          ))
        }
      </mds-table-body>
    </mds-table>
  </ProjectBlock>
</ProjectLayout>

<script>
  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function initScrollShiftSpans() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll<HTMLElement>('[data-scroll-shift]').forEach((span) => {
      const section = span.closest('section');
      if (!section) return;

      const maxDeg = Number.parseFloat(span.dataset.scrollShiftMax ?? '80');
      let rafId: number | null = null;

      const update = () => {
        const rect = section.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const scrollRange = viewportHeight + rect.height;
        const progress = clamp((viewportHeight - rect.top) / scrollRange, 0, 1);

        span.style.transform = `rotate(${progress * maxDeg}deg)`;
      };

      const onScroll = () => {
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          rafId = null;
          update();
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    });
  }

  initScrollShiftSpans();
</script>
