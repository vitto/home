---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategoryCards from '../components/CategoryCards.astro';
import Footer from '../components/Footer.astro';
import Blob from '../components/Blob.astro';
import Blobmixer from '../components/Blobmixer.astro';
import Trunk from '../components/Trunk.astro';
import blobmixerPresets from '../data/blobmixer-presets.json';

// The homepage background, blob, trunk or blobmixer: ?background= picks another one, to compare them
const backgrounds = ['blob', 'trunk', 'blobmixer'] as const;
const defaultBackground: (typeof backgrounds)[number] = 'blobmixer';
const requestedBackground = Astro.url.searchParams.get('background');
const background = backgrounds.find((name) => name === requestedBackground) ?? defaultBackground;

// With the blobmixer, the blob shown at rest is Slinky: ?preset= picks another one, to try them all
const defaultBlobmixerPreset: keyof typeof blobmixerPresets = 'slinky';
const requestedPreset = Astro.url.searchParams.get('preset') ?? '';
const blobmixerPreset =
  requestedPreset in blobmixerPresets
    ? (requestedPreset as keyof typeof blobmixerPresets)
    : defaultBlobmixerPreset;

// The cards tint the page with the accent recommended with their blob, ?tint=dominant with the label closest to it
const blobmixerTintColor =
  Astro.url.searchParams.get('tint') === 'dominant' ? 'dominant' : 'accent';
---

<Layout>
  {
    background === 'blob' && (
      <Blob positionY={0.75} positionYMobile={0.5} scale={0.875} maxScrollTranslate={200} />
    )
  }
  {
    background === 'blobmixer' && (
      <Blobmixer
        preset={blobmixerPreset}
        tintColor={blobmixerTintColor}
        positionY={0.75}
        positionYMobile={0.5}
        scale={0.875}
        maxScrollTranslate={200}
      />
    )
  }
  {background === 'trunk' && <Trunk shape="logo" anchor=".vv-logo" />}
  <Hero inverse={background === 'blobmixer' ? 'light' : background === 'blob'} />
  <CategoryCards background={background} />
  <Footer background={background} />
</Layout>
