---
import '../styles/global.css';
import { getPreferences } from '../utils/preferences';
import PreventAnimation from '../components/PreventAnimation.astro';
import CSSCriticalPath from '../components/CSSCriticalPath.astro';
import ChangePageClick from '../components/ChangePageClick.astro';
import HeaderNav from '../components/HeaderNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vittorio - Design System Architect & Senior Product Designer',
  description = 'Crafting scalable human-centered experiences through systematic design thinking.',
} = Astro.props;

// Get base URL from Astro config and normalize it
// Remove trailing slash if present (except for root)
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl === '/' ? '' : rawBaseUrl.replace(/\/$/, '');
const magmaLoaderUrl = `${baseUrl}/vendor/maggioli-loader/${__MAGMA_VERSION__}`;
const preferences = getPreferences(Astro.cookies);
---

<!doctype html>
<html
  lang="en"
  class={`${preferences.mode.selector} prevent-animation`}
  style={preferences.mode.style}
  data-pref-mode={preferences.mode.value}
  data-magma-pref
>
  <head>
    <meta charset="UTF-8" />
    <PreventAnimation />
    <CSSCriticalPath />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/assets/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="module" define:vars={{ baseUrl, magmaLoaderUrl }}>
      (async () => {
        // Import Maggioli loader from vendor directory
        // First apply polyfills, then load components
        const { applyPolyfills } = await import(`${magmaLoaderUrl}/dist/esm/polyfills/index.js`);
        await applyPolyfills();
        const { defineCustomElements } = await import(`${magmaLoaderUrl}/dist/esm/loader.js`);
        defineCustomElements();
        window.sessionStorage.setItem('mdsIconSvgPath', `${baseUrl}/icons/`);
      })();
    </script>
  </head>
  <body class="bg-surface-default text-fg-default antialiased" role="main">
    <slot />
    <HeaderNav />
    <ChangePageClick />
  </body>
</html>
